{
  "info": {
    "name": "Global E-Commerce API (v1.0)",
    "description": "Comprehensive Postman Collection for the Global E-Commerce Platform Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7245",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login (Sets Token Auto)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    console.log('Token successfully stored:', jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ecommerce.global\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Customer Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@ecommerce.global\",\n  \"password\": \"CustomerPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newshopper@ecommerce.global\",\n  \"password\": \"ShopperPass123!\",\n  \"confirmPassword\": \"ShopperPass123!\",\n  \"firstName\": \"Zaid\",\n  \"lastName\": \"Ahmed\",\n  \"phoneNumber\": \"+923009876543\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Product Catalog & Search",
      "item": [
        {
          "name": "Get All Products (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Full-Text Search & Faceted Discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search?query=leather&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search"],
              "query": [
                { "key": "query", "value": "leather" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Autocomplete Suggestions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search/suggestions?query=lea&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search", "suggestions"],
              "query": [
                { "key": "query", "value": "lea" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Get Categories Tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Cart & Wishlist",
      "item": [
        {
          "name": "Get Current Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart"]
            }
          }
        },
        {
          "name": "Get Customer Wishlist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wishlist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wishlist"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Checkout & Orders",
      "item": [
        {
          "name": "Generate Checkout Quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingCountryCode\": \"US\",\n  \"shippingPostalCode\": \"97477\",\n  \"couponCode\": \"WELCOME10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkout/quote",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkout", "quote"]
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin Analytics & Operations",
      "item": [
        {
          "name": "Executive Dashboard KPIs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/analytics/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "analytics", "dashboard"]
            }
          }
        },
        {
          "name": "Sales Trend Analytics (Daily)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/analytics/sales-trend?interval=Daily",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "analytics", "sales-trend"],
              "query": [
                { "key": "interval", "value": "Daily" }
              ]
            }
          }
        },
        {
          "name": "Trigger Expired Holds Release Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/jobs/release-holds",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "jobs", "release-holds"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Health & Diagnostics",
      "item": [
        {
          "name": "Health Status (JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Diagnostics Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/diagnostics/ping",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "diagnostics", "ping"]
            }
          }
        },
        {
          "name": "Diagnostics System Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/diagnostics/info",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "diagnostics", "info"]
            }
          }
